{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raeva.dev/schemas/rv-lock.json",
  "title": "rv.lock schema 4",
  "description": "The canonical Raeva v0.3 lock format. Writers always emit schema 4. Readers also adapt schema 1-3 lockfiles into a one-module in-memory reactor view.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 4,
      "description": "Current on-disk schema version."
    },
    "config_hash": {
      "type": "string",
      "description": "Hash of resolution configuration inputs. Credentials are excluded."
    },
    "resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy"],
      "description": "Resolution settings that come from the command line rather than configuration files, and so are not covered by config_hash. Absent on schema 1-3 locks; readers treat an absent table as unknown and re-resolve.",
      "properties": {
        "strategy": {
          "enum": ["nearest", "highest"],
          "description": "Version-mediation strategy the resolver used."
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": { "$ref": "#/$defs/platform" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "repo_ids": {
          "type": "string",
          "description": "Newline-separated 'url<TAB>id' lines for the id'd repositories that backed resolution, so export-m2 can label _remote.repositories markers for POM-declared repos."
        },
        "support_repo_ids": {
          "type": "string",
          "description": "Newline-separated support-POM (parent / imported BOM) provenance lines. Each line is 'g:a:v<TAB>repo_id' or 'g:a:v<TAB>repo_id<TAB>sha256', where sha256 is 64 lowercase hex characters naming the exact POM bytes resolution parsed. rv rejects a lockfile with any other line shape, a duplicated coordinate, or an invalid digest; a two-field line is the pre-digest form and leaves that POM unpinned, and the next non-frozen sync rewrites it with a digest.",
          "pattern": "^[^\\t\\n:]+:[^\\t\\n:]+:[^\\t\\n:]+\\t[^\\t\\n]*(\\t[0-9a-f]{64})?(\\n[^\\t\\n:]+:[^\\t\\n:]+:[^\\t\\n:]+\\t[^\\t\\n]*(\\t[0-9a-f]{64})?)*$"
        }
      }
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "model_hash", "artifacts", "modules"],
      "not": {
        "anyOf": [
          { "required": ["packages"] },
          { "required": ["edges"] }
        ]
      },
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+-[A-Za-z0-9_]+$"
        },
        "model_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 model-input hash. B1 covers root POM bytes plus active profile ids; B4 extends the input set to the full active reactor and local-parent models."
        },
        "artifacts": {
          "type": "array",
          "description": "Unique external artifact pins. Workspace and system-scoped nodes never appear here.",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/module" }
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "artifact", "version", "packaging"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "packaging": { "type": "string", "minLength": 1 },
        "classifier": { "type": "string" }
      }
    },
    "gav": {
      "type": "object",
      "additionalProperties": false,
      "description": "Effective coordinates of a reactor module. One reserved value is not a real coordinate: readers adapting a schema 1-3 lockfile mint a single synthetic root module stamped {group: \"__legacy__\", artifact: \"__root__\", version: \"0\"}, because legacy locks record no module identity. Writers never emit it (a re-resolved lock always carries real coordinates), consumers must not try to resolve it, and rv renders that module by its pom path rather than by these values.",
      "required": ["group", "artifact", "version"],
      "properties": {
        "group": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["coordinate", "repo_url", "checksums"],
      "properties": {
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "repo_url": { "type": "string" },
        "checksums": {
          "type": "array",
          "items": { "$ref": "#/$defs/checksum" }
        },
        "pom_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the companion .pom bytes this lockfile was resolved against, recorded by rv sync where those bytes were parsed. Pins which POM export-m2 ships for this coordinate, since the store's coordinate index is last-writer-wins. Every row naming one group:artifact:version must carry the same value, across classifiers and across platforms: Maven has one local-repository path per coordinate. Absent only on a lockfile written before POM pinning; export then falls back to the index, unpinned, and the next non-frozen sync resolves again and records the pin."
        },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp"],
      "properties": {
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{8}\\.[0-9]{6}$"
        },
        "build_number": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "gav", "packaging", "packages", "edges"],
      "properties": {
        "path": { "$ref": "#/$defs/pomPath" },
        "gav": { "$ref": "#/$defs/gav" },
        "packaging": { "type": "string", "minLength": 1 },
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/modulePackage" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "modulePackage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["coordinate"],
      "not": {
        "required": ["repo_url"]
      },
      "allOf": [
        {
          "not": {
            "required": ["checksum"]
          }
        },
        {
          "not": {
            "required": ["checksums"]
          }
        },
        {
          "not": {
            "required": ["snapshot"]
          }
        },
        {
          "not": {
            "required": ["snapshot_timestamp"]
          }
        },
        {
          "not": {
            "required": ["workspace_module", "system_path"]
          }
        }
      ],
      "properties": {
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "direct_scope": { "type": "string" },
        "workspace_module": { "$ref": "#/$defs/pomPath" },
        "system_path": { "type": "string" }
      }
    },
    "pomPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?:[^/]+/)*pom\\.xml$",
      "description": "Normalized workspace-root-relative POM path using forward slashes."
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 0 },
        "scope": { "type": "string" },
        "optional": { "type": "boolean", "default": false }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "type": "string" },
        "digest": { "type": "string" }
      },
      "oneOf": [
        {
          "properties": {
            "algorithm": { "const": "sha256" },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "properties": {
            "algorithm": { "const": "sha1" },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      ]
    }
  }
}
