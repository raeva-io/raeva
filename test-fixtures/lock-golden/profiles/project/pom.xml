<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.golden.app</groupId>
  <artifactId>profiles</artifactId>
  <version>1.0</version>

  <properties>
    <core.version>1.0</core.version>
    <native.classifier>linux-x86_64</native.classifier>
  </properties>

  <repositories>
    <repository>
      <id>fixture</id>
      <url>file://${project.basedir}/repository/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.golden</groupId>
      <artifactId>core</artifactId>
      <version>${core.version}</version>
    </dependency>
    <dependency>
      <groupId>org.golden</groupId>
      <artifactId>native</artifactId>
      <version>1.0</version>
      <classifier>${native.classifier}</classifier>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <native.classifier>windows-x86_64</native.classifier>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.golden</groupId>
          <artifactId>util</artifactId>
          <version>1.0</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>defaults</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <native.classifier>osx-aarch_64</native.classifier>
      </properties>
    </profile>
    <profile>
      <id>extra</id>
      <activation>
        <property>
          <name>with.extra</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.golden</groupId>
          <artifactId>runtime-only</artifactId>
          <version>1.0</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>named</id>
      <dependencies>
        <dependency>
          <groupId>org.golden</groupId>
          <artifactId>lib</artifactId>
          <version>1.0</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>never</id>
      <activation>
        <property>
          <name>!with.extra</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.golden</groupId>
          <artifactId>optional-extra</artifactId>
          <version>1.0</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
