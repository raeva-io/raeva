<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jdk</groupId>
  <artifactId>d-value-answers-jdk-activation</artifactId>
  <version>1.0</version>
  <repositories>
    <repository>
      <id>repo</id>
      <url>file://${project.basedir}/repo/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <profiles>
    <profile>
      <id>jdk-27</id>
      <activation><jdk>27</jdk></activation>
      <dependencies>
        <dependency><groupId>org.jdk</groupId><artifactId>lib</artifactId><version>27</version></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jdk-11</id>
      <activation><jdk>11</jdk></activation>
      <dependencies>
        <dependency><groupId>org.jdk</groupId><artifactId>lib</artifactId><version>11</version></dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
