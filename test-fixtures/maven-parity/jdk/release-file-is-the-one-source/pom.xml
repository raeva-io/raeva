<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.jdk</groupId>
  <artifactId>release-file-is-the-one-source</artifactId>
  <version>1.0</version>
  <repositories>
    <repository>
      <id>repo</id>
      <url>file://${project.basedir}/repo/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.jdk</groupId>
      <artifactId>lib</artifactId>
      <version>${java.version}</version>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>jdk-27</id>
      <activation><jdk>27</jdk></activation>
      <dependencies>
        <dependency><groupId>org.jdk</groupId><artifactId>extra</artifactId><version>1</version></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>java-version-27</id>
      <activation>
        <property><name>java.version</name><value>27</value></property>
      </activation>
      <dependencies>
        <dependency><groupId>org.jdk</groupId><artifactId>other</artifactId><version>1</version></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jdk-17</id>
      <activation><jdk>17</jdk></activation>
      <dependencies>
        <dependency><groupId>org.jdk</groupId><artifactId>old</artifactId><version>1</version></dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
