<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.sel</groupId>
  <artifactId>file-conditions</artifactId>
  <version>1.0</version>
  <profiles>
    <profile>
      <id>exists-with-spaces-from-property</id>
      <activation><file><exists>${spaced}</exists></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>exists-wins-over-missing</id>
      <activation><file><exists>marker</exists><missing>marker</missing></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>exists-expanding-to-nothing</id>
      <activation><file><exists>${empty}</exists></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>missing-expanding-to-nothing</id>
      <activation><file><missing>${empty}</missing></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>exists-through-absent-directory</id>
      <activation><file><exists>absent/../marker</exists></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>exists-with-backslash</id>
      <activation><file><exists>.\marker</exists></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
    <profile>
      <id>missing-only</id>
      <activation><file><missing>absent</missing></file></activation>
      <dependencyManagement><dependencies><dependency><groupId>org.sel</groupId><artifactId>managed</artifactId><version>1</version></dependency></dependencies></dependencyManagement>
    </profile>
  </profiles>
</project>
